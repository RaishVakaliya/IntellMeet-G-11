PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

MONGO_URI=your_mongodb_connection_string

JWT_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
SESSION_SECRET=your_session_secret

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

REDIS_URL=redis://localhost:6379

GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_secret

SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
SENTRY_ENVIRONMENT=development

# Grafana Cloud background metrics pusher (optional)
GRAFANA_CLOUD_URL=https://prometheus-prod-43-prod-ap-south-1.grafana.net/api/prom/push
GRAFANA_CLOUD_USERNAME=your_grafana_cloud_user_id
GRAFANA_CLOUD_PASSWORD=your_grafana_cloud_api_token